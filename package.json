{
  "name": "ai-builder-jobs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "jobs": "node apps/cli/dist/index.js",
    "test": "pnpm -r test && node --test design/board-concepts.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "board:dev": "pnpm --filter @ai-builder-jobs/board dev",
    "board:catalog": "pnpm --filter @ai-builder-jobs/board catalog",
    "board:deploy-preview": "node scripts/deploy-board-preview.mjs"
  },
  "pnpm": {
    "overrides": {
      "better-auth": "1.7.22",
      "@better-auth/core": "1.7.22",
      "@better-auth/oauth-provider": "1.7.22",
      "@better-auth/passkey": "1.7.22",
      "@better-auth/telemetry": "1.7.22",
      "@better-auth/api-key": "1.7.22",
      "better-call@1.4.0": "1.4.5",
      "@better-fetch/fetch@1.3.2": "1.3.3",
      "zod@4.5.4": "4.6.7",
      "zod@4.1.11": "4.6.7",
      "nanoid@3.3.12": "3.3.18",
      "postcss@8.5.14": "8.5.18",
      "source-map-js@1.2.1": "1.2.2",
      "vite@7.3.3": "7.3.7",
      "vitest@3.2.4": "3.2.6"
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.4",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
