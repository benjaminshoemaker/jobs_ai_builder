{
  "name": "@ai-builder-jobs/board",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 8780",
    "start": "next start --hostname 127.0.0.1 --port 8780",
    "build": "pnpm --filter @ai-builder-jobs/core build && next build --webpack",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "catalog": "tsx src/catalog-cli.ts",
    "dev:legacy": "tsx watch src/server.ts",
    "db:migrate": "node --env-file=.env.local --import tsx scripts/migrate.ts",
    "db:seed-preview": "node --env-file=.env.local --import tsx scripts/seed-preview.ts",
    "collect:preview": "node --env-file=.env.local --import tsx scripts/collect-preview.ts",
    "maintain:preview": "node --env-file=.env.local --import tsx scripts/maintain-listings.ts",
    "discover:preview": "node --env-file=.env.local --import tsx scripts/discover-broad.ts",
    "assess:preview": "node --env-file=.env.local --import tsx scripts/assess-discovery.ts",
    "evaluate:preview": "node --env-file=.env.local --import tsx scripts/evaluate-discovery.ts",
    "pipeline:preview": "node --env-file=.env.local --import tsx scripts/run-pipeline.ts",
    "verify:pipeline": "node --env-file=.env.local --import tsx scripts/verify-pipeline.ts"
  },
  "dependencies": {
    "@ai-builder-jobs/core": "workspace:^",
    "@neondatabase/auth": "0.7.0-beta",
    "@vercel/functions": "^3.10.4",
    "he": "^2.0.0",
    "next": "^16.4.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "robots-parser": "^3.0.1",
    "sanitize-html": "^2.18.1",
    "workflow": "^5.5.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/he": "^1.2.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2"
  }
}
